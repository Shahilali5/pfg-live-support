# PFG Live Support Environment Configuration
PORT=3000
NODE_ENV=development

# Admin Authentication Secret
JWT_SECRET=pfg_super_secret_jwt_key_2026_dev_secure

# Database Configuration (Optional: defaults to persistent JSON store if DATABASE_URL is not set)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/pfg_support

# File Upload Limit (in bytes - default 10MB)
MAX_FILE_SIZE=10485760

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
SOCKET_RATE_LIMIT_MAX=10
SOCKET_RATE_LIMIT_WINDOW_MS=5000

# Default Site ID for embedded widget
DEFAULT_SITE_ID=pfg_gateway_default
